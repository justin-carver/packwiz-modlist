# Configure this information for local testing, and then rename to `.env.`
MODPACK_TOML_PATH="../relative/or/absolute/path/to/mod/root"
# NOTE: single quotes, not double. dotenv expands $VAR inside double quotes,
# and a CurseForge key is bcrypt-shaped ($2a$10$...), so double quotes silently
# eat most of it -- you get a 403 with an empty body, if double-quoted.
CF_API_KEY='unsure-if-this-is-needed_$keeping-for-testing'